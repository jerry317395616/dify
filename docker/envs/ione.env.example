# I-ONE deployment overrides. Copy this file to `ione.env` and pass it after
# `.env` so these values win during Compose interpolation.

CONSOLE_API_URL=https://dify.example.com
CONSOLE_WEB_URL=https://dify.example.com
SERVICE_API_URL=https://dify.example.com
APP_API_URL=https://dify.example.com
APP_WEB_URL=https://dify.example.com
FILES_URL=https://dify.example.com
NEXT_PUBLIC_SOCKET_URL=wss://dify.example.com

EXPOSE_NGINX_PORT=18080
EXPOSE_NGINX_SSL_PORT=18443

IONE_DIFY_API_IMAGE=ione/dify-api:local
IONE_DIFY_WEB_IMAGE=ione/dify-web:local
IONE_DIFY_AGENT_IMAGE=ione/dify-agent-backend:local
IONE_QWEN_NETWORK=ione-qwen-internal

# Do not expose Dify's remote/built-in application templates.
HOSTED_FETCH_APP_TEMPLATES_MODE=db

# Optional Frappe console SSO. Keep JIT disabled until the OAuth Client and
# existing target Dify tenant have been verified. Never commit the real secret.
FRAPPE_OAUTH_BASE_URL=https://child.myyr.top
FRAPPE_OAUTH_CLIENT_ID=
FRAPPE_OAUTH_CLIENT_SECRET=
FRAPPE_OAUTH_ALLOWED_ROLES=I-ONE Agent Manager,System Manager
FRAPPE_OAUTH_JIT_ENABLED=false
FRAPPE_OAUTH_JIT_TENANT_ID=7cdfa690-411d-425d-a3b3-c19bf338c2f5
FRAPPE_OAUTH_JIT_TENANT_ROLE=admin
