# I-ONE deployment overrides. Copy this file to `ione.env` and pass it after
# `.env` so these values win during Compose interpolation.

CONSOLE_API_URL=https://dify.example.com
CONSOLE_WEB_URL=https://dify.example.com
SERVICE_API_URL=https://dify.example.com
APP_API_URL=https://dify.example.com
APP_WEB_URL=https://dify.example.com
FILES_URL=https://dify.example.com

EXPOSE_NGINX_PORT=18080
EXPOSE_NGINX_SSL_PORT=18443

IONE_DIFY_API_IMAGE=ione/dify-api:local
IONE_DIFY_WEB_IMAGE=ione/dify-web:local
IONE_DIFY_AGENT_IMAGE=ione/dify-agent-backend:local
IONE_QWEN_NETWORK=ione-qwen-internal
